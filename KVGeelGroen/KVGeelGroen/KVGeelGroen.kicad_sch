	(text "SMAJ%.0A TV recommended per datasheet MCP73831.\nDecoupling capacitors per datasheet AP2112K (linear converter).\nBattery only indicative on the schematic. Connect via header.\nPut right AP2112K version (3V3) in BOM!"
		(exclude_from_sim no)
		(at 281.178 31.496 0)
		(effects
			(font
				(face "Segoe UI Semibold")
				(size 1.905 1.905)
				(thickness 0.1588)
				(color 36 81 58 1)
			)
			(justify right)
		)
		(uuid "4de8977a-0fcc-45ad-b93c-210b1786c660")
	)
	(text "Delay circuit at input by recommendation of datasheet.\nAs many pins (including thermal pads) disconnected for better hand assembly."
		(exclude_from_sim no)
		(at 280.924 141.732 0)
		(effects
			(font
				(face "Segoe UI Semibold")
				(size 1.905 1.905)
