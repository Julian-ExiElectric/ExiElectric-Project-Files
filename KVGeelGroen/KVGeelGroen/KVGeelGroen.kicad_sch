		(uuid "65fa3bef-b91b-483f-9fbe-ae08f8d4cc90")
	)
	(text "2 switches; one toggel for EN between 3V3 and GND, \nother toggle for GPIO16/GPIO23 between 3V3 and GND.\nHeader broken out for debugging for GPIO25/26,\n GPIO1/3, GPIO34+GPIO39/GPIO35+GPIO39, and GND/3V3."
		(exclude_from_sim no)
		(at 281.686 128.778 0)
