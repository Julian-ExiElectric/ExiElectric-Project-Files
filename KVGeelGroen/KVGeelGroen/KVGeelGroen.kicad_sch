			)
			(justify right)
		)
		(uuid "60ddcbca-c5af-4d9d-abc5-f1634411d923")
	)
	(text "Exi-Electric, Julian van Ham"
		(exclude_from_sim no)
		(at 223.266 177.292 0)
		(effects
			(font
				(face "Segoe UI Semibold")
